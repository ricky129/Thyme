# SSH destination used by deploy.sh and by `thyme` when no target is given.
deploy.user=your-user
deploy.host=your-server.example

# Optional. Defaults to ~/docker/thyme and port 22.
deploy.remote_dir=~/docker/thyme
# deploy.port=2222

# Optional private key path. If omitted, OpenSSH uses ssh-agent and ~/.ssh/config.
# deploy.key=~/.ssh/id_ed25519

# Alternatively, omit deploy.host and set a URL here:
# server.tailscale=http://your-server.example:7000
